              "pattern": "^https://",
              "maxLength": 4096,
              "description": "Landing a la que lleva el anuncio. No es el archivo del creativo. Sin los mismos parámetros que el UTM."
            },
            "source_type": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "manifest"
              ]
            },
            "thumbnail_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 4096,
              "description": "Landing a la que lleva el anuncio. No es el archivo del creativo. Sin los mismos parámetros que el UTM."
            }
          },
          "required": [
            "source_url",
            "source_type"
          ],
          "description": "Imagen/video: requiere name; video requiere thumbnail_url. Manifest: SOLO source_url y source_type; su JSON contiene CampaignRequest."
        }
      },
      "required": [
        "request"
      ]
    }
  },
  {
    "name": "orbita_publish_campaign",
    "description": "Crea la estructura del borrador en Meta. Puede activar/gastar si target_status=ACTIVE. Usala cuando el usuario pidió publicar y los parámetros están definidos; no pidas confirmación de cada paso interno.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "draft_id",
        "plan_hash"
      ]
    }
  },
  {
    "name": "orbita_activate_campaign",
    "description": "Activa una estructura ya creada. Puede comenzar a gastar; requiere instrucción del usuario para ese plan y presupuesto.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "job_id",
        "plan_hash"
      ]
    }
  },
  {
    "name": "orbita_list_campaign_jobs",
    "description": "Lista las publicaciones recientes con estado y resumen.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": []
    }
  },
  {
    "name": "orbita_campaign_status",
    "description": "Consulta progreso local; SIMULATED nunca significa publicado en Meta.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "job_id"
      ]
    }
  },
  {
    "name": "orbita_campaign_remote",
    "description": "Lee estado real en Meta por objeto y fase: EN_REVISION, RECHAZADO, ACTIVO, PAUSADO; delivering solo con impresiones.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "job_id"
      ]
    }
  },
  {
    "name": "orbita_pause_campaign",
    "description": "Solicita pausar todas las campañas de este trabajo; verificar respuesta y estado remoto.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "job_id"
      ]
    }
  },
  {
    "name": "orbita_campaign_insights",
