# Copiar a .env, completar y cargarlo en el entorno. El servicio NO lee .env solo.
ORBITA_SERVICE_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
META_MODE=mock
ENABLE_LIVE_PUBLISH=false
META_GRAPH_VERSION=v26.0
META_ACCESS_TOKEN=
META_APP_SECRET=
# Hosts exactos, separados por coma, o * para aceptar cualquier host HTTPS con IP pública
# (la protección SSRF por IP pública fijada sigue activa). Sin redirecciones.
ASSET_ALLOWED_HOSTS=cdn.tu-dominio.com,tu-bucket.s3.amazonaws.com
# true solo si el hosting obliga a salir a Internet por HTTPS_PROXY.
META_USE_ENV_PROXY=false
ORBITA_DB=data/orbita.sqlite3
HOST=127.0.0.1
PORT=8787
